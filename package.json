{
  "name": "shipyard",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "build:cloud": "node scripts/check-cloud-config.mjs && ng build --configuration cloud",
    "emulators": "node scripts/emulators.mjs",
    "test": "npm run test:e2e && npm run test:rules",
    "test:e2e": "playwright test",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:build": "npm run build && playwright test --config playwright.build.config.ts"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "dependencies": {
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.31",
    "@angular/compiler": "20.3.31",
    "@angular/core": "20.3.31",
    "@angular/fire": "20.0.1",
    "@angular/forms": "20.3.31",
    "@angular/platform-browser": "20.3.31",
    "@angular/platform-browser-dynamic": "20.3.31",
    "@angular/platform-server": "20.3.31",
    "@angular/router": "20.3.31",
    "firebase": "^11.8.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.37",
    "@angular/cli": "20.3.37",
    "@angular/compiler-cli": "20.3.31",
    "@axe-core/playwright": "^4.11.0",
    "@firebase/rules-unit-testing": "4.0.1",
    "@playwright/test": "^1.58.0",
    "firebase-tools": "^14.0.0",
    "typescript": "~5.9.3"
  }
}
